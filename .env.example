# Copy to .env for local development. NEVER commit the real .env.

# --- Storage ---
# Local default (SQLite) needs no value. For Postgres (Neon/Render) set e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./channel_radar.db

# --- AI layer (Google AI Studio, free tier) ---
# Get a key at https://aistudio.google.com/app/apikey (no credit card).
# Leave empty to run without AI — the dashboard still works, digests show
# "unavailable" and posts fall back to a keyword categorizer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Background collection ---
# Shared secret required by POST /api/cron/collect (leave empty to disable auth).
CRON_SECRET=
# Set to 1 only on always-on hosts (e.g. Fly.io) to run the in-process scheduler.
RUN_SCHEDULER=0
COLLECT_INTERVAL_MINUTES=30
MIN_RECOLLECT_MINUTES=5
